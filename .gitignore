# Godot
.godot/
*.translation
export_presets.cfg.bak
/build/
# tool caches / raw downloads
tools/_cache/
__pycache__/
*.pyc
*.blend1
# logs
*.log

# Godot extracts textures embedded in .glb files on import (<model>_<image>.png/jpg).
# They are regenerated on every import, so only the .glb sources are committed.
assets/env/*/*.png
assets/env/*/*.jpg
assets/env/*/*.png.import
assets/env/*/*.jpg.import
!assets/env/preview_sheet.png
assets/characters/*/*_*.png
assets/characters/*/*_*.jpg
assets/characters/*/*_*.png.import
assets/characters/*/*_*.jpg.import
assets/bosses/*/*_*.png
assets/bosses/*/*_*.jpg
assets/bosses/*/*_*.png.import
assets/bosses/*/*_*.jpg.import
assets/weapons/carrot_*_*.png
assets/weapons/carrot_*_*.jpg
assets/weapons/carrot_*_*.png.import
assets/weapons/carrot_*_*.jpg.import
# (your arsenal's: the same textures, extracted from the .glb on import)
assets/weapons/root_rumbler_root_rumbler_*
assets/weapons/big_root_50_big_root_50_*
assets/props/*_*_*.png
assets/props/*_*_*.jpg
assets/props/*_*_*.png.import
assets/props/*_*_*.jpg.import
# ...but keep hand-made previews that happen to match those patterns
!assets/props/acorn_helmet_closeup.png
!assets/props/acorn_helmet_closeup.png.import
!assets/props/preview_sheet*.png
!assets/props/preview_sheet*.png.import

# personal audio review state (tools/audio/review.py)
tools/audio/review_notes.json
tools/audio/review_notes.json.bak
tools/audio/review_notes.json.tmp
tools/audio/review_notes.json.repaired-*
tools/audio/review_baseline.json
# the owner's game-change notes (tools/notes/notes.py)
tools/notes/game_notes.json
tools/notes/game_notes.json.bak
tools/notes/game_notes.json.tmp
tools/notes/.game_notes.json.lock
tools/notes/.game_notes.json.watcher
